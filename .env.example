NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_OIDC_ACCOUNT_URL=https://identity.example.com/account/security
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_OIDC_ISSUER=https://identity.example.com
EXPO_PUBLIC_OIDC_CLIENT_ID=zoryqon-mobile
DATABASE_URL=postgresql://zoryqon:zoryqon_local@localhost:5432/zoryqon
DATABASE_SSL=disable
REDIS_URL=redis://localhost:6379
EVENT_BROKER_URL=tcp://localhost:9092
OBJECT_STORAGE_ENDPOINT=http://localhost:9002
OBJECT_STORAGE_BUCKET=zoryqon-development
OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=zoryqon-api
OIDC_CLIENT_ID=zoryqon-web
OIDC_CLIENT_SECRET=replace-with-secret-manager-reference
OIDC_REDIRECT_URI=http://localhost:4000/v1/auth/callback
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
ZORYQON_TENANT_REF=replace-with-active-tenant-reference
PAYMENT_PROVIDER_BASE_URL=https://payments.example.com
PAYMENT_PROVIDER_API_KEY=replace-with-secret-manager-reference
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
CUSTODY_PROVIDER_BASE_URL=https://custody.example.com
CUSTODY_PROVIDER_API_KEY=replace-with-secret-manager-reference
PRICE_PROVIDER_BASE_URL=https://prices.example.com
PRICE_PROVIDER_API_KEY=replace-with-secret-manager-reference
COMPLIANCE_PROVIDER_BASE_URL=https://compliance.example.com
COMPLIANCE_PROVIDER_API_KEY=replace-with-secret-manager-reference
RESOLUTION_DISPUTE_WINDOW_HOURS=24
NOTIFICATION_PROVIDER_BASE_URL=https://notifications.example.com
NOTIFICATION_PROVIDER_API_KEY=replace-with-secret-manager-reference
WORKER_POLL_INTERVAL_MS=1000
LOG_LEVEL=info
TRUST_PROXY=false
