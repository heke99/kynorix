# Zoryqon uses one hosted Supabase project for Postgres, Auth, Storage and Realtime.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=zoryqon-private

# Supabase > Connect > Session pooler (port 5432) or Direct connection.
# Do not use transaction mode on port 6543 for migrations.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_SSL=require

# Generated automatically by npm run env:init when missing.
SESSION_ENCRYPTION_KEY=
SESSION_MAX_AGE_SECONDS=2592000
ZORYQON_TENANT_REF=zoryqon

# External production providers. Leave both fields empty in development when a flow is not used.
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
CUSTODY_PROVIDER_BASE_URL=
CUSTODY_PROVIDER_API_KEY=
PRICE_PROVIDER_BASE_URL=
PRICE_PROVIDER_API_KEY=
COMPLIANCE_PROVIDER_BASE_URL=
COMPLIANCE_PROVIDER_API_KEY=
NOTIFICATION_PROVIDER_BASE_URL=
NOTIFICATION_PROVIDER_API_KEY=

RESOLUTION_DISPUTE_WINDOW_HOURS=24
WORKER_POLL_INTERVAL_MS=1000
LOG_LEVEL=info
TRUST_PROXY=false
