{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoryqon.example/schemas/realtime-event-v1.json",
  "title": "Zoryqon realtime event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "eventId",
    "channel",
    "eventType",
    "serverTimestamp",
    "marketTimestamp",
    "payloadVersion",
    "payload"
  ],
  "properties": {
    "sequence": { "type": "string", "pattern": "^[0-9]+$" },
    "eventId": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "minLength": 1 },
    "serverTimestamp": { "type": "string", "format": "date-time" },
    "marketTimestamp": { "type": "string", "format": "date-time" },
    "payloadVersion": { "const": "1" },
    "payload": {}
  }
}
